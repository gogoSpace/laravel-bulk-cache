{
    "name": "gogospace/laravel-bulk-cache",
    "description": "Batched cache loading with explicit scopes and guarded Redis publication for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "predis/predis": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "GogoSpace\\BulkCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GogoSpace\\BulkCache\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GogoSpace\\BulkCache\\BulkCacheServiceProvider"
            ],
            "aliases": {
                "BulkCache": "GogoSpace\\BulkCache\\Facades\\BulkCache"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@composer validate --strict",
            "@php vendor/bin/pint --test",
            "@php vendor/bin/phpstan analyse --memory-limit=512M",
            "@php vendor/bin/phpunit"
        ],
        "test:concurrency": "@php tools/concurrency.php",
        "smoke": "@php tools/smoke.php",
        "docs:check": "@php tools/docs.php",
        "package:check": "@php tools/package.php",
        "benchmark:smoke": "@php tools/benchmark.php",
        "upgrade:check": "@php tools/upgrade.php",
        "consumer:redis": "@php tools/consumer-redis.php"
    },
    "archive": {
        "exclude": [
            "/research",
            "/AGENTS.md",
            "/tests",
            "/tools",
            "/.github",
            "/phpunit.xml",
            "/phpstan.neon",
            "/composer.lock",
            "/pint.json"
        ]
    }
}
